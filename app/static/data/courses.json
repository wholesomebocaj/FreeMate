                {
                  "type": "click-all-squares",
                  "title": "Find rank 4",
                  "body": "Now click every square on rank 4.",
                  "targetSquares": ["a4", "b4", "c4", "d4", "e4", "f4", "g4", "h4"],
                  "highlightSquares": [
                    { "square": "a4", "className": "rank" },
                    { "square": "b4", "className": "rank" },
                    { "square": "c4", "className": "rank" },
                    { "square": "d4", "className": "rank" },
