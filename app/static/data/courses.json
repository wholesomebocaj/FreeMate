        {
          "id": "game-ending-rules",
          "title": "Game Endings",
          "subskills": ["Check", "Checkmate", "Stalemate"],
          "lessons": [
            {
              "id": "checkmate-vs-stalemate",
              "title": "Checkmate vs Stalemate",
              "summary": "Understand the difference between a forced win and a drawn position.",
              "difficulty": "Beginner",
              "ratingRange": "200-600",
              "timeMinutes": 5,
              "locked": false,
              "coachIntro": "Beginners often mix up checkmate and stalemate. This lesson gives you a simple ending checklist.",
              "steps": [
                {
                  "type": "explain",
                  "title": "Know the difference",
                  "body": "Checkmate means the king is attacked and has no escape. Stalemate means the king is not attacked, but has no legal move."
                },
                {
                  "type": "multiple-choice",
                  "title": "Is this checkmate or stalemate?",
                  "body": "Look at the board and choose the correct ending.",
                  "board": true,
                  "fen": "7k/6Q1/5K2/8/8/8/8/8 b - - 0 1",
                  "highlightSquares": [
                    { "square": "h8", "className": "target" },
                    { "square": "g8", "className": "danger" },
                    { "square": "h7", "className": "danger" }
                  ],
                  "choices": [
                    { "label": "Checkmate", "value": "checkmate" },
                    { "label": "Stalemate", "value": "stalemate" }
                  ],
                  "correctChoice": "checkmate",
                  "successText": "Correct. The king is attacked and has no escape.",
                  "errorText": "Not quite. This one is checkmate."
                },
                {
                  "type": "multiple-choice",
                  "title": "Now spot the stalemate",
                  "body": "This one is different. The king is not in check, but still cannot move.",
                  "board": true,
                  "fen": "7k/5Q2/6K1/8/8/8/8/8 b - - 0 1",
                  "highlightSquares": [
                    { "square": "h8", "className": "focus" },
                    { "square": "g8", "className": "danger" },
                    { "square": "h7", "className": "danger" }
                  ],
                  "choices": [
                    { "label": "Checkmate", "value": "checkmate" },
                    { "label": "Stalemate", "value": "stalemate" }
                  ],
                  "correctChoice": "stalemate",
                  "successText": "Correct. The king is stuck, but not in check.",
                  "errorText": "Not quite. This one is stalemate."
                },
                {
                  "type": "guided-puzzle",
                  "title": "Remember the difference",
                  "body": "Checkmate ends the game because the king is attacked. Stalemate ends the game because the king has no move."
                }
              ]
            }
          ]
        }
      ]
