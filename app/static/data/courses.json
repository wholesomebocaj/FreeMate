                    { "square": "d8", "className": "file" },
                    { "square": "a4", "className": "rank" },
                    { "square": "b4", "className": "rank" },
                    { "square": "c4", "className": "rank" },
                    { "square": "e4", "className": "rank" },
                    { "square": "f4", "className": "rank" },
                    { "square": "g4", "className": "rank" },
                    { "square": "h4", "className": "rank" }
                  ]
                },
                {
                  "type": "click-all-squares",
