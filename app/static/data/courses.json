                  "successText": "Great. You found rank 4."
                },
                {
                  "type": "square-click",
                  "title": "Find d4",
                  "body": "Click the square where file d and rank 4 meet.",
                  "targetSquare": "d4",
                  "highlightSquares": [
                    { "square": "d4", "className": "target" }
                  ],
                  "successText": "Great. d4 is the intersection of the d-file and rank 4."
